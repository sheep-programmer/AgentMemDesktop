# AgentMem 环境变量示例
# 复制为 .env 后填写真实值；.env 不入库。

# ---------- 全局设置 ----------
# 数据根目录（Space、原始文件、向量库都落在这里）
AGENTMEM_DATA_DIR=./data
# 监听地址与端口
AGENTMEM_HOST=127.0.0.1
AGENTMEM_PORT=8765
# 日志级别：DEBUG | INFO | WARNING | ERROR
AGENTMEM_LOG_LEVEL=INFO
# 运行模式：dev 时允许前端 5173 跨域；prod 时托管 apps/web/dist
AGENTMEM_ENV=dev
# 模型 Provider 配置文件路径
AGENTMEM_MODELS_CONFIG=./config/models.yaml

# ---------- 摄取与检索 ----------
# 切片目标长度与重叠（token）
# AGENTMEM_CHUNK_SIZE=512
# AGENTMEM_CHUNK_OVERLAP=80
# 一次向量化多少条切片，以及同时发出几批
# AGENTMEM_EMBEDDING_BATCH_SIZE=32
# AGENTMEM_EMBEDDING_CONCURRENCY=3
# 同时摄取的文档数（多出来的排队等待）
# AGENTMEM_INGEST_CONCURRENCY=2
# 摄取时为每篇文档生成一段上下文（拼在索引与嵌入文本前，不进正文）
# AGENTMEM_CONTEXTUAL_RETRIEVAL=true

# ---------- 云端模型 API Key ----------
# 与 config/models.yaml 中的 ${VAR} 占位符对应
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
SILICONFLOW_API_KEY=

# ---------- 本地模型服务 ----------
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8000/v1

# ---------- 本地 Embedding / Rerank ----------
# auto 会依次尝试 mps → cuda → cpu
AGENTMEM_DEVICE=auto
# HuggingFace 镜像（国内网络可设 https://hf-mirror.com）
# HF_ENDPOINT=https://hf-mirror.com
